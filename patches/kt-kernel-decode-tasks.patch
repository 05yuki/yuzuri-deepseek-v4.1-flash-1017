+// One task of a decode GEMM job: block `ith` of `nth` of matrix `mat` of the job.
+struct KtDecodeTask {
+  int mat, ith, nth;
+};
+// A job's tasks in the order the pool hands them out. The threads of a part share one memory bus and do not
+// finish together: with equal tasks the job lasts until the last one ends, about half a task after the
+// others (measured on DeepSeek-V4.1's experts, 2 x 30 threads: about 30 us a layer at any number of experts).
+// Here the job's last `tail` kernel blocks are cut in halves (the first half of them), quarters (the next
+// quarter) and eighths (the rest), in whole multiples of 8 rows, so a thread that comes free near the end
+// takes a small piece. Every output row is computed by the same loop as before. `pairs` = 2 keeps the
+// gate / up alternation of the job (matrix 2e is expert e's gate, 2e + 1 its up).
+inline void kt_decode_tasks(std::vector<KtDecodeTask>& out, int mats, int pairs, int n, int nth, int tail) {
+  out.clear();
+  const int rows = n / nth, units = mats * nth;
+  if (n % nth != 0 || rows % 8 != 0) tail = 0;
+  tail = std::min(std::max(tail, 0), units);
+  for (int u = 0; u < units; u++) {
+    const int p = u / pairs, mat = (p / nth) * pairs + u % pairs, ith = p % nth;
+    int d = 1;
+    const int j = u - (units - tail);
+    if (j >= 0) d = j < tail / 2 ? 2 : (j < tail / 2 + tail / 4 ? 4 : 8);
+    while (d > 1 && (rows % d != 0 || (rows / d) % 8 != 0)) d /= 2;
+    for (int s2 = 0; s2 < d; s2++) out.push_back({mat, ith * d + s2, nth * d});
+  }
+}
+inline std::atomic<uint64_t>& kt_decode_serial() {
+  static std::atomic<uint64_t> v{1};
+  return v;
+}
